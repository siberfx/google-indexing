{
  "name": "siberfx/google-indexing",
  "description": "Notify Google (Indexing API + Search Console sitemaps) and IndexNow search engines (Bing, Yandex, Naver, Seznam, Yep) about new, updated and deleted URLs. Reads your sitemap.xml, auto-hooks into Eloquent models, queues everything.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "seo", "google", "indexing", "indexnow", "bing", "sitemap", "search-console", "ping"],
  "authors": [
    {
      "name": "Selim Görmüş",
      "email": "info@siberfx.com",
      "role": "Software Engineer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-openssl": "*",
    "ext-simplexml": "*",
    "illuminate/bus": "^12.0|^13.0",
    "illuminate/cache": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/queue": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.9",
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Siberfx\\GoogleIndexing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Siberfx\\GoogleIndexing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "format": "pint"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Siberfx\\GoogleIndexing\\GoogleIndexingServiceProvider"
      ],
      "aliases": {
        "GoogleIndexing": "Siberfx\\GoogleIndexing\\Facades\\GoogleIndexing"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
